{
  "default_sport": "basketball",
  "grader": "psa",

  "filters": {
    "min_total_population": 300,
    "max_gem_rate_pct": 20,
    "min_price_usd": 20,
    "min_recent_sales": 3,
    "recent_sales_window_days": 60
  },

  "ranking_weights": {
    "price_momentum": 0.5,
    "gem_rate_tightness": 0.3,
    "sales_activity": 0.2
  },

  "scan_limits": {
    "max_sets_per_run": 40,
    "max_card_pages_per_run": 250,
    "request_delay_seconds": 1.5,
    "max_results": 50
  },

  "category_map": {
    "basketball": "basketball-cards",
    "baseball": "baseball-cards",
    "football": "football-cards",
    "hockey": "hockey-cards",
    "soccer": "soccer-cards",
    "tcg": "tcg-cards"
  }
}
